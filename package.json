{
  "name": "dsh-impeccable-studio",
  "version": "0.6.2",
  "description": "Design review desk (设计校审台) for DeepSeek Harness: 24 design commands, 62 deterministic detectors and a one-click scan. Findings grouped by problem; hand-drawn paper panel in warm paper or kraft, with Chinese/English and light/dark/auto. Skill included.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.png",
  "files": [
    "lib",
    "locale/*.json",
    "skill",
    "cordis.patch.yml",
    "icon.png",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "impeccable",
    "design-review",
    "ui-audit",
    "accessibility"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsnancy/dsh-impeccable.git"
  },
  "homepage": "https://github.com/jsnancy/dsh-impeccable#readme",
  "bugs": {
    "url": "https://github.com/jsnancy/dsh-impeccable/issues"
  },
  "author": "jsnancy",
  "license": "Apache-2.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  }
}
